# syntax=docker/dockerfile:1.7

###############################################################################
# BlakPath development image.
#
# Used by docker-compose.yml for hot-reload development. The host source tree is
# bind-mounted over /app, so this image only needs the toolchain (pnpm + tsx)
# and container-local node_modules. NOT for production — see Dockerfile.
###############################################################################

# Node 24 LTS, same version as production. Digest is the multi-arch index for
# node:24.22.1-slim (Debian bookworm). Bump the version and digest together.
ARG NODE_VERSION=24.22.1
FROM node:${NODE_VERSION}-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS os

ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV NEXT_TELEMETRY_DISABLED=1

# tini for signal handling; curl for compose healthchecks; procps for pgrep.
# Upgrade so Debian security fixes (the pinned snapshot lags) are applied.
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get install -y --no-install-recommends tini curl ca-certificates procps \
  && rm -rf /var/lib/apt/lists/*
# npm and Yarn ship with the Node image and are unused; pnpm comes from Corepack
# in the next stage.
RUN rm -rf /usr/local/lib/node_modules/npm /opt/yarn* \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
    /usr/local/bin/yarn /usr/local/bin/yarnpkg

WORKDIR /app

FROM os AS toolchain
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

FROM toolchain

# Prime the dependency cache. The compose bind-mount overlays source at runtime,
# but a named volume keeps /app/node_modules from being shadowed by the host.
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile

# Run as the stock non-root `node` user shipped in the base image.
RUN chown -R node:node /app
USER node

EXPOSE 3000

ENTRYPOINT ["/usr/bin/tini", "--"]
# Default command is overridden per-service in docker-compose.yml
# (web -> pnpm dev, worker -> pnpm worker:dev).
CMD ["pnpm", "dev"]
