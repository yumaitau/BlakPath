# BlakPath environment configuration — copy to .env and fill in.
# NEVER commit a real .env. Secrets in production come from a secret manager
# (e.g. AWS Secrets Manager / KMS), not from this file.

NODE_ENV=development
APP_URL=http://localhost:3000
APP_REGION=ap-southeast-2

# Local developer accounts printed by `pnpm db:seed`. Requires this flag and a
# loopback DATABASE_URL (localhost, 127.0.0.1, or ::1). Never set it for a
# shared or production database. Production ignores it.
ALLOW_DEV_SEED=1

# --- Database ---
DATABASE_URL=postgres://blakpath:blakpath@localhost:5432/blakpath
# Production only: owning role, distinct from DATABASE_URL. Local migrate falls
# back to DATABASE_URL. See infra/postgres/audit-roles.sql.
# DATABASE_MIGRATION_URL=postgres://blakpath_migrator:blakpath@localhost:5432/blakpath
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# --- Envelope encryption ---
# Tenant keys are rows in organisation_keys (KMS CMK or XKS key ARN).
# Development and CI use a deterministic local provider. Optional pin:
# ENCRYPTION_LOCAL_KEY=  (openssl rand -base64 32). Refused in production.
# Production platform CMK for non-tenant data. Required by the release gate.
# PLATFORM_KMS_KEY_ARN=arn:aws:kms:ap-southeast-2:123456789012:key/uuid
# Localstack or a KMS stub. Refused in production.
# KMS_ENDPOINT=http://localhost:4566
# Legacy version-1 ciphertext only. Not used for new writes.
# ENCRYPTION_MASTER_KEY=

# --- Object storage (MinIO locally, AWS S3 ap-southeast-2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=blakpath
S3_SECRET_ACCESS_KEY=blakpath-dev-secret
# Production only: customer-managed KMS key ARN. Leave the access-key pair
# above unset in production so the AWS SDK uses the workload role.
# S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-2:123456789012:key/uuid
S3_BUCKET_EVIDENCE=blakpath-evidence
S3_BUCKET_QUARANTINE=blakpath-quarantine
S3_BUCKET_AUDIT_ANCHORS=blakpath-audit-anchors
# Production ConfigMap sets this true. The bucket must already have Object Lock.
AUDIT_ANCHOR_OBJECT_LOCK=false
# AUDIT_ANCHOR_SIGNING_KEY_ID=arn:aws:kms:ap-southeast-2:123456789012:key/uuid
# Optional local HMAC. When unset outside production, the envelope master key is used.
# AUDIT_ANCHOR_HMAC_KEY=replace-me-with-a-long-random-secret-at-least-32-chars
S3_FORCE_PATH_STYLE=true

# --- ClamAV (malware scanning) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Email (Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=BlakPath <no-reply@blakpath.local>

# --- PaperBoy transactional email (production) ---
# Sender posts JSON to {PAPERBOY_URL}/api/v1/emails with
# `Authorization: Bearer <PAPERBOY_API_KEY>`. Leave unset locally.
# PAPERBOY_URL=https://paperboy.yumait.au
# PAPERBOY_API_KEY=pb_live_replace-me

# SES bounce/complaint topic. POST /api/email/events checks the SNS signature
# and this exact ARN. The shared secret is the x-email-webhook-secret header,
# never a query parameter. Leave unset locally.
# EMAIL_WEBHOOK_SECRET=replace-with-at-least-16-chars
# EMAIL_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:blakpath-email-events

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=blakpath
LOG_LEVEL=info

# --- Background scheduler ---
# Intervals are milliseconds. Schedulers reconcile active organisations every
# five minutes, and BullMQ persists the actual schedule in Redis.
AUDIT_VERIFY_INTERVAL_MS=86400000
RETENTION_SWEEP_INTERVAL_MS=86400000
SCHEDULER_SYNC_INTERVAL_MS=300000
# DescribeKey + canary decrypt per active tenant. Default is five minutes.
KEY_HEALTH_INTERVAL_MS=300000
# Operator mailbox for tenant key state changes. Required in production.
# OPERATOR_ONCALL_EMAIL=oncall@blakpath.internal

# --- CoA cryptographic signing ---
# Production: KMS asymmetric key (SIGN_VERIFY) under the workload role.
# Alias or key ARN; seals always record the resolved key ARN.
# COA_SIGNING_KEY_ID=alias/blakpath-coa-signing
# Local development and CI only: PEM private key below. NEVER set this in
# production — the app refuses to start signing with it outside development.
# Generate: node -e "console.log(require('node:crypto').generateKeyPairSync('rsa',{modulusLength:2048}).privateKey.export({type:'pkcs8',format:'pem'}))"

# --- Feature toggles ---
# AI is OFF by default and must never be able to decide, score or infer identity.
# External tool access (/api/mcp) stays hidden until this is true AND a tenant
# administrator records governance approval under step-up.
AI_FEATURES_ENABLED=false
# Per-key requests allowed each minute on /api/mcp. Default 60.
# MCP_RATE_LIMIT_PER_MINUTE=60

# --- Webhook delivery ---
# Built-in policy already refuses private, loopback, link-local, CGNAT and
# unique-local addresses. Add comma-separated CIDRs for this deployment's
# cluster or VPC ranges when they fall outside those defaults.
# WEBHOOK_DENY_CIDRS=10.42.0.0/16,fd12:3456::/32
