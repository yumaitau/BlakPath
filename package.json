{
  "name": "blakpath",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "ioredis": "^5.11.1",
      "form-data": "^4.0.6",
      "vite": "^6.4.3",
      "esbuild@<=0.24.2": "^0.25.0",
      "file-type@>=13.0.0 <21.3.1": "^21.3.1",
      "uuid@<11.1.1": "^11.1.1",
      "postcss@<8.5.18": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<=4.28.6": "^4.28.7",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "vitest"
      ]
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "DATABASE_URL=postgres://blakpath:blakpath@localhost:5432/blakpath knip --no-progress && depcheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "bash scripts/verify-live-stack.sh",
    "release:check": "tsx scripts/check-production-readiness.ts",
    "release:check:bundle": "node scripts/build-release-check.mjs",
    "test:restore": "bash scripts/verify-restore-drill.sh",
    "key-ceremony": "tsx scripts/key-ceremony.ts",
    "screenshot": "tsx scripts/capture-readme-screenshots.ts",
    "screenshot:landing": "tsx scripts/capture-readme-screenshot.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:drift": "bash scripts/check-schema-drift.sh",
    "db:push": "tsx scripts/guard-db-push.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seeds/index.ts",
    "certificates:backfill-signing-keys": "tsx scripts/backfill-coa-signing-keys.ts",
    "admin:invite": "tsx scripts/invite-first-admin.ts",
    "worker": "BLAKPATH_PROCESS=worker tsx worker/index.ts",
    "worker:dev": "BLAKPATH_PROCESS=worker tsx watch worker/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1130.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-sesv2": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@better-auth/passkey": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "better-auth": "^1.6.0",
    "bullmq": "^5.21.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "file-type": "^22.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.1.16",
    "next": "16.3.8",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shamir-secret-sharing": "0.0.4",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.10.0",
    "depcheck": "^1.4.7",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "knip": "^6.41.0",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
