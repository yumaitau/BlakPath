{
  "region": "ap-southeast-2",
  "deletionProtection": true,
  "logging": {
    "clusterLogging": [
      {
        "enabled": true,
        "types": ["api", "audit", "authenticator", "controllerManager", "scheduler"]
      }
    ]
  },
  "encryptionConfig": [
    {
      "resources": ["secrets"],
      "provider": {
        "keyArn": "${SecretsKeyArn}"
      }
    }
  ]
}
